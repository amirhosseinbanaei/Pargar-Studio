# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*

# testing
/coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files — .env.example IS committed; it is the configuration contract
.env*.local

# databases (prompt 2 seeds a local SQLite file here)
*.db

# vercel
.vercel

# typescript
*.tsbuildinfo
# Rewritten by Next on every dev<->build flip (it points at .next/dev/types in one mode
# and .next/types in the other), so tracking it means a permanently dirty tree. Regenerate
# it on a clean checkout with `npm run typegen`, which must run before `npm run typecheck`
# there — the generated route types do not exist yet and tsc reports confident nonsense
# about page props without them.
next-env.d.ts
