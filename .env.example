# Target path in a real project: <repo-root>/.env.example
#
# THIS FILE IS THE CONFIGURATION CONTRACT.
# Every variable the app reads appears here, documented, in the SAME COMMIT that first
# reads it. A variable that exists only in one person's .env.local is a production outage
# scheduled for the first day that person is unavailable.
#
# The value of this file is the COMMENT, not the key: say what the variable does and what
# happens at each value, so a stranger can act on it without reading the source.
#
# NEVER put a real secret here — not even a "dev only" one. Leave the key empty and
# document how to obtain it. `.gitignore` ignores `.env*.local`, so this file is committed
# and `.env.local` never is.
#
# BUILD TIME vs RUNTIME — this distinction decides where a value must be supplied:
#   NEXT_PUBLIC_*  → inlined into the browser bundle during `npm run build`. Setting one
#                    on a running container does NOTHING. Pass them as Docker build ARGs
#                    and on the CI build step (prompt 7).
#   everything else → read per request on the server. Supplied by the orchestrator.
#
# Several keys below are declared before the code that reads them exists. That is
# deliberate: the prompt that consumes each one is named on its comment, and declaring the
# contract up front is what stops prompt 2 and prompt 6 each inventing their own spelling.

# ─────────────────────────── Public origin (public) ───────────────────────────
# Public origin this app is served from — metadata base, sitemap, robots, canonical URLs,
# OG images. INLINED AT BUILD TIME: changing it requires a rebuild, not a restart.
# NO DEFAULT IN CODE: the env module throws if this is missing. A localhost fallback would
# turn a loud startup failure into a silent production misconfiguration where every
# canonical link points at a machine nobody can reach.
# CONSUMED BY: prompt 1 (`src/common/constants/api.ts`), prompt 4 (route metadata).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin serving uploaded media, if one is ever introduced. LEAVE EMPTY: this site ships
# zero image files — every drawing is generated as SVG at runtime from the record's slug.
# It also feeds the image-optimizer allowlist in next.config.ts, which fails closed to an
# empty list while this is unset, so no host is proxied by accident.
# CONSUMED BY: prompt 1 (`next.config.ts`, `src/common/constants/api.ts`).
NEXT_PUBLIC_MEDIA_URL=

# ────────────────────────── Content database (server-only) ────────────────────
# libSQL connection URL for the content database — the 76 projects, 9 design works, 14
# media entries, and the studio and contact records, in both locales.
#   libsql://<name>-<org>.turso.io   → a deployed Turso database
#   file:./kavan.db                  → a local file, which is what `npm run dev` uses
# NO DEFAULT IN CODE: a missing URL must stop the boot, not connect to nothing.
# CONSUMED BY: prompt 2 (the db ring).
TURSO_DATABASE_URL=file:./kavan.db

# Turso auth token. Required for a `libsql://` URL, unused for a local `file:` one — which
# is why the schema marks it optional and lets the driver enforce the pairing.
# Obtain with: turso db tokens create <database-name>
# CONSUMED BY: prompt 2 (the db ring).
TURSO_AUTH_TOKEN=

# ─────────────────────── Admin dashboard auth (server-only) ───────────────────
# The single admin password the dashboard authenticates against. There is one admin and no
# user table: this value IS the credential, so treat it like one.
# CONSUMED BY: prompt 6 (the sign-in Server Action).
ADMIN_PASSWORD=

# Signing key for the admin session cookie. MINIMUM 32 CHARACTERS, enforced by the schema:
# on a single-signed-cookie design, a short secret makes the signature forgeable, and a
# forgeable session cookie is the whole authentication bypass.
# Generate with: openssl rand -base64 32
# CONSUMED BY: prompt 6 (the session module).
SESSION_SECRET=

# ────────────────────────── Uploaded images (server-only) ─────────────────────
# ABSOLUTE path to the directory uploaded images are written to and served from.
# There is NO DEFAULT and the schema refuses a relative path: a default would turn a
# missing value into writes that land somewhere nobody looks — the dashboard says the
# image saved, the file sits on an ephemeral container layer, and it is gone at the next
# deploy with no error anywhere. A missing value stops the boot with the key named.
#   /data/uploads   → in the container; `compose.yaml` mounts the `uploads` volume there.
#                     WITHOUT THAT VOLUME every uploaded file is destroyed on redeploy.
#   <repo>/uploads  → locally. Write it out in full (dotenv does not expand $PWD);
#                     `.gitignore` covers `/uploads/`.
# CONSUMED BY: prompt 10 (`common/services/upload-store.ts`, `/api/uploads`, `/api/media`).
UPLOAD_DIR=
