# Target path in a real project: <repo-root>/.env.example
#
# THIS FILE IS THE CONFIGURATION CONTRACT.
# Every variable the app reads appears here, documented, in the SAME COMMIT that first
# reads it. A variable that exists only in one person's .env.local is a production outage
# scheduled for the first day that person is unavailable.
#
# The value of this file is the COMMENT, not the key: say what the variable does and what
# happens at each value, so a stranger can act on it without reading the source.
#
# NEVER put a real secret here — not even a "dev only" one. Leave the key empty and
# document how to obtain it. Gitignore rule, opt-in so a new secret file can never be
# committed by accident:
#
#     .env*
#     !.env.example
#
# BUILD TIME vs RUNTIME — this distinction decides where a value must be supplied:
#   NEXT_PUBLIC_*  → inlined into the browser bundle during `npm run build`. Setting one
#                    on a running container does NOTHING. Pass them as Docker build ARGs
#                    and on the CI build step.
#   everything else → read per request on the server. Supplied by the orchestrator.

# ───────────────────────── Backend endpoints (public) ─────────────────────────
# Base URL of the REST API, including any version prefix. INLINED AT BUILD TIME —
# changing it requires a rebuild, not a restart.
# NO DEFAULT IN CODE: the env module throws if this is missing. A localhost fallback would
# turn a loud startup failure into a silent production misconfiguration where every
# request goes to a machine that does not exist.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin this app is served from — metadata base, sitemap, robots, canonical URLs.
# Wrong here means every canonical link and OG image URL in production points elsewhere.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin serving uploaded media, when it differs from the API origin. Optional: many
# backends return absolute media URLs already. Also feeds the image-optimizer allowlist in
# next.config.ts — a host that is not derivable from these values will 400 at the
# optimizer with an "unconfigured host" error.
NEXT_PUBLIC_MEDIA_URL=

# ───────────────────── Endpoints the backend has not shipped ──────────────────
# 'enabled'  → routes the backend does not implement yet serve fixture data instead of
#              failing, so those screens render while the API catches up. Each fallback is
#              logged once per fetch in development.
# 'disabled' → see the true state of the API (empty sections, real errors).
# Defaults to 'disabled' in code ON PURPOSE: a fallback that is on by default makes a real
# outage look like a permanently empty screen.
NEXT_PUBLIC_PENDING_API_MOCKS=disabled

# ───────────────── Request-mock front-db (only if the project has one) ────────
# 'enabled'  → the app runs fully standalone against the in-process mock front-db, with no
#              backend at all — the recommended local, demo, and CI-build mode ONCE the
#              mock layer exists.
# 'disabled' → talk to the real backend configured above.
# Shipped as 'disabled' so a checkout that has no `src/mocks/` yet still boots; flip it on
# the day you add the mock layer. It also defaults to 'disabled' in the env module, so a
# build that forgets to pass it can never ship mocks.
# Read with a LITERAL `process.env.NEXT_PUBLIC_API_MOCKING` and reached only through
# `await import()`; a static import would ship the whole seed dataset to every browser.
NEXT_PUBLIC_API_MOCKING=disabled

# 'enabled'  → persist front-db mutations to browser storage so they survive a reload
#              (good for demoing a multi-step flow).
# 'disabled' → deterministic fresh seed on every load. REQUIRED for tests: persistence
#              defeats the per-test reset and makes test order matter.
NEXT_PUBLIC_MOCK_PERSIST=disabled

# ─────────────────────── Internal endpoints (server-only) ─────────────────────
# Container-to-container base URL for server-side fetches. The browser resolves
# `localhost`; the server container resolves the service name over the compose network.
# These are two different values and both are needed — collapsing them into one breaks
# whichever side you did not test.
INTERNAL_API_URL=

# ──────────────────────── Session cookies (server-only) ───────────────────────
# Whether session cookies carry the `Secure` attribute. LEAVE THIS UNSET: the app decides
# per request from the forwarded-proto header and then the request origin, so ONE build
# serves both an https host and a plain-http one (a phone hitting an http LAN address, an
# IP:port staging box).
#
# Why it matters: a browser SILENTLY DISCARDS a `Secure` cookie delivered over http. The
# symptom is that sign-in appears to succeed and then every authenticated request 401s,
# with no error anywhere — on some hosts only.
#
# Set it only behind a TLS terminator that forwards neither signal:
#   SESSION_COOKIE_SECURE=true   → always Secure (https-only deployment)
#   SESSION_COOKIE_SECURE=false  → never Secure  (plain-http deployment)
SESSION_COOKIE_SECURE=

# ───────────────────────── Cache purge (server-only) ──────────────────────────
# Shared secret the backend sends (as a request header) to purge tagged caches through the
# revalidation route. Leave UNSET to disable that endpoint entirely — an unauthenticated
# purge endpoint is a free cache-stampede button for anyone who finds the URL.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=

# ──────────────────── Operational scripts (server-only, optional) ─────────────
# Tokens used by anything under `scripts/` (design-token pulls, one-off migrations).
# NO `NEXT_PUBLIC_` PREFIX, ever — an operational credential must never reach a browser
# bundle. Document how to obtain each one; leave the value empty.
# DESIGN_TOOL_TOKEN=
